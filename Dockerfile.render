# Build the edited backend and frontend from this branch. The official frontend
# image is used only as the licensed source of the charting runtime assets.
FROM ghcr.io/nofxaios/nofx/nofx-frontend@sha256:24cc53e9e0e10c5467933ebbe0c7512336117adc2cea3c0414563c76a8eace73 AS chart-assets

FROM golang:1.26-alpine AS backend-build
WORKDIR /src
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /out/nofx .

FROM node:24-alpine AS frontend-build
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY web/ ./
# The upstream chart library is private. Its built runtime assets are present
# in the pinned official frontend image and are sufficient for this source build.
COPY --from=chart-assets /usr/share/nginx/html/charting_library/ ./vendor/charting/charting_library/
RUN npm run build

FROM alpine:3.22
RUN apk add --no-cache bash ca-certificates nginx gettext tini postgresql-client \
    && mkdir -p /run/nginx /app/data /usr/share/nginx/html
COPY --from=backend-build /out/nofx /app/nofx
COPY --from=frontend-build /src/web/dist/ /usr/share/nginx/html/
COPY render/nginx.conf.template /app/render/nginx.conf.template
COPY render/start.sh render/protect-tables.sql /app/render/
RUN chmod +x /app/render/start.sh

ENV PORT=10000 API_SERVER_PORT=8081 DB_TYPE=postgres DB_PORT=5432 \
    DB_NAME=postgres DB_SSLMODE=require TRANSPORT_ENCRYPTION=true \
    EXPERIENCE_IMPROVEMENT=false TZ=Africa/Cairo
EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD wget -q -O /dev/null "http://127.0.0.1:${PORT}/health" || exit 1
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/app/render/start.sh"]
